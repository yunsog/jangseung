# /etc/jangseung/jangseung.conf : 장승 (Jangseung) 설정 예. 이 파일을 복사해서 고침.
#
# 형식 : [구역] 아래 "키 = 값". # 뒤는 주석. 없는 키 = 기본값. 명령줄 옵션이 이 파일보다 우선.
# 모르는 키 / 같은 키 두 번 / 잘못된 값이 있으면 시작하지 않음 (오타 방지). 검사만 : jangseung -check -c <파일>
# 읽는 곳 : jangseung -c <파일>, 없으면 /etc/jangseung/jangseung.conf 가 있을 때만.
# 바꾼 뒤 : sudo systemctl reload jangseung (계속 돌면서 다시 읽음). listen / timeout 은 restart 해야 바뀜 (아래 "(restart)")

[haetae]
url     = http://127.0.0.1:5002   # 해태 HTTP API 주소 (필수). 장승이 부르는 쪽이라 해태의 "내부" 허용 목록에 이 서버가 있으면 내부 API 도 씀
timeout = 20s                     # 해태 API 한 번의 제한 시간 (restart)

[listen]
# 장승이 듣는 주소 (restart).
#   127.0.0.1:8330 = 이 컴퓨터에서만 (기본). 앞에 nginx 같은 프록시를 두는 구성 (권장 : TLS / 접속 제한 / 로그인을 프록시가 맡음)
#   0.0.0.0:8330   = 인터넷 전체. 프록시 없이 직접 열 때. 이때는 TLS 가 없고 접속 제한도 없음 -> 방화벽 / 상위 장비가 막아야 함
addr = 127.0.0.1:8330

[internal]
# 로그인 뒤에만 보이는 화면 (SLURM, RTR 라우터, 내부 요약). 기본 = 끔 (공개 화면만).
# 켜려면 앞단 프록시가 "로그인을 통과한 요청에만" 아래 헤더에 key_file 의 값을 붙여 줘야 함 (nginx : deploy/nginx-jangseung.conf 참고).
# 헤더가 없거나 값이 다르면 이 화면들은 404. 프록시를 건너뛰어 들어와도 열리지 않음.
enabled  = no
key_file = /etc/jangseung/internal.key   # 비밀 값 한 줄 (16 자 이상). 예 : openssl rand -hex 24 > 파일, chmod 640, 그룹 = 장승 계정
header   = X-Jangseung-Key

[web]
# 모든 화면을 로그인한 사람에게만 (사내 전용으로 쓸 때). 기본 = no (공개).
# yes 이면 [internal] 의 key_file / header 를 그대로 씀 : 프록시가 로그인을 확인한 요청에만 비밀 헤더를 붙여야 하고,
# 헤더가 없으면 403 (/jangseung-healthz 만 예외 : systemd 워치독이 자기 확인에 씀).
# 장승은 로그인을 직접 하지 않음 -> 반드시 프록시 (nginx auth_request 등) 가 앞에 있어야 함. 이때 "내부" 화면 (SLURM / RTR) 은
# enabled = yes 이면 로그인한 모두에게 보임 (구분이 필요하면 프록시에서 /internal/ 만 따로 제한).
require_login = no
# 프록시가 /rpki/ 같은 아래 경로로 줄 때 X-Forwarded-Prefix: /rpki 헤더로 알려 줌.
#   auto = 그 헤더를 믿음 (trust_proxy 에 든 주소에서 온 요청만), /이름 = 고정, 비움 = 없음 (루트에 둠)
base_path   = auto
# 프록시 주소 (쉼표로 여러 개, 범위 가능). 이 주소에서 온 요청의 X-Forwarded-Prefix 만 믿음. 직접 열 때는 비워도 됨
trust_proxy = 127.0.0.1, ::1
# 화면 언어 : auto = 브라우저 (Accept-Language), ko / en = 고정. (화면 위의 언어 선택 / ?lang= 은 항상 우선)
lang        = auto

[cache]
ttl      = 60s    # 같은 해태 API 경로를 다시 부르기까지 (방문자가 많아도 해태가 받는 요청은 이 주기에 한 번)
refresh  = 5m     # 전체 목록 (VRP / ASPA / 라우터 키) 을 다시 받는 최소 간격
max_rows = 500    # 한 화면 표의 줄 수 상한 (10 ~ 100000)
upstream_rps = 20 # 캐시에 없어 해태로 새로 가는 요청의 초당 상한 (1 ~ 1000). 넘으면 마지막 캐시 또는 "바쁨" 안내
