# /etc/systemd/system/jangseung.service : 장승 (공개 웹 화면). 설정은 /etc/jangseung/jangseung.conf (예 deploy/jangseung.conf.example)
[Unit]
Description=Jangseung (RPKI web view of Haetae)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
# Type=notify : 포트를 연 뒤 READY=1. WatchdogSec : 장승이 자기 화면에 실제로 물어보고 답할 때만 WATCHDOG=1 (notify.go).
#   3 분 동안 알림이 없으면 (서버가 막힘) systemd 가 죽이고 다시 띄움. 신호를 못 보내는 옛 실행 파일과는 같이 쓰지 말 것 (시작 시간 초과)
Type=notify
NotifyAccess=main
WatchdogSec=3min
User=jangseung
Group=jangseung
# 옵션은 모두 설정 파일에서. systemctl reload jangseung = 설정 다시 읽기 (재시작 아님)
ExecStart=/usr/local/bin/jangseung
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# 자원 상한
MemoryMax=512M
CPUQuota=100%
# 보호 : 장승은 파일을 쓰지 않고 소켓만 씀
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# 1024 미만 포트 (80 / 443) 로 직접 열 때만 : CapabilityBoundingSet=CAP_NET_BIND_SERVICE + AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077

[Install]
WantedBy=multi-user.target
